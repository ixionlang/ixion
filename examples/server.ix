use <std>
use <json>
use <web/types>
use <web/response>
use <web/router>
use <web/server>

def user(request: types::Request): types::Response {
    return case router::param(request, "id") {
        Option::Some(id) => response::json(200, json::Value::Object([("id", json::Value::String(id))])),
        Option::None => response::text(400, "Missing user id"),
    }
}

def jsonEcho(request: types::Request): types::Response {
    return case json::parse(request.body) {
        Result::Ok(value) => response::json(200, value),
        Result::Err(_) => response::json(400, json::Value::Object([("error", json::Value::String("Invalid JSON"))])),
    }
}

def main() {
    let routes = [
        router::route("GET", "/", lambda (request) { return response::text(200, "Hello, Ixion!") }),
        router::route("GET", "/health", lambda (request) { return response::text(200, "ok") }),
        router::route("GET", "/users/:id", lambda (request) { return user(request) }),
        router::route("GET", "/users/me", lambda (request) { return response::json(200, json::Value::Object([("id", json::Value::String("current-user"))])) }),
        router::route("POST", "/json/echo", lambda (request) { return jsonEcho(request) }),
        router::route("POST", "/echo", lambda (request) { return response::text(200, request.body) })
    ]
    let result = server::serve(types::config("127.0.0.1", 8080), lambda (request) {
        return router::dispatch(routes, request)
    })
    case result {
        Result::Ok(_) => { std::println("Server stopped") },
        Result::Err(error) => { std::println(error) },
    }
}
