use <std>

pub def main() {
    let mut add = lambda (a: int, b: int): int {
        return a + b
    }

    std::println(add(20, 22))

    let mut greet = lambda (name: string): void {
        std::println("Hello, " + name)
    }
    greet("Ixion")

    std::println(lambda (x: int): int {
        return x * x
    }(7))
}
