use <std>

def numbers() : int[] {
    return [10, 20, 30]
}

pub def main() {
    let mut source = "abc"
    std::println(source[0])
    std::println(source[1 + 1])
    std::println(("xyz")[1])
    std::println(case numbers()[1] { Option::Some(value) => value, Option::None => -1, })
    let mut matrix = [[1, 2], [3, 4]]
    std::println(case matrix[1] {
        Option::Some(row) => case row[0] { Option::Some(value) => value, Option::None => -1, },
        Option::None => -1,
    })
    let mut cursor = 0
    std::println(source[cursor++])
    std::println(cursor)
    let empty: int[] = []
    std::println(empty)
}
