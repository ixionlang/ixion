use <std>

def increment(value : int) : int {
    let mut local = value
    let mut before = local++
    return before + local
}

pub def main() {
    let mut cursor = 0
    while cursor < 2 {
        cursor++
    }
    std::println(cursor)
    let mut before = cursor--
    std::println(before)
    while cursor > 0 {
        cursor--
    }
    std::println(cursor)
    let mut decimal = 0.0d
    while decimal < 2.0d {
        decimal++
    }
    std::println(decimal)
    std::println(decimal--)
    std::println(decimal)
    std::println(increment(3))
}
